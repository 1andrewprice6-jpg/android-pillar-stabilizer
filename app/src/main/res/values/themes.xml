<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose-only base theme. Extends a platform NoActionBar theme so we
        don't pull in AppCompat or the Material View library just for a theme
        reference. Compose draws all visual styling itself.
    -->
    <style name="Theme.PillarStabilizer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
    </style>
</resources>
